import manejadores.*
import helado.*
import direcciones.*
import frutas.*
import powerUps.*
import wollok.game.*
import extras.*
import niveles.*
import movimientoRectangular.*
import enemigos.*
import velocidades.*


  
  describe "consumisición de frutas" {
    
    test "cuando la fruta recibe un choque del helado desaparece" {
      const fruta = new Frambuesa (position = game.at(1,1))
      fruta.recibirChoqueDe(helado)
      assert.equals(0, game.getObjectsIn(fruta.position()).size())
    }
  
    test "cuando cada fruta recibe un choque del helado suma la cantidad de puntos correspondiente a la fruta en cuestión" {
      const fruta = new Frambuesa (position = game.at(1,1))
      const fruta2 = new Uva (position = game.at(2,2))
      const fruta3 = new Kiwi (position = game.at(3,3), movimiento = derecha)
      fruta.recibirChoqueDe(helado)
      assert.equals(fruta.puntosOtorgados(), puntaje.puntos())
      fruta2.recibirChoqueDe(helado)
      assert.equals(fruta2.puntosOtorgados(), puntaje.puntos() - fruta.puntosOtorgados())
      fruta3.recibirChoqueDe(helado)
      assert.equals(fruta3.puntosOtorgados(), puntaje.puntos() - fruta.puntosOtorgados() - fruta2.puntosOtorgados())
    }
  }

describe "movimiento del helado" {
  test "al ir a la derecha avanza una casilla" {
    helado.moverHacia(derecha)
    assert.equals(game.at(1, 0), helado.position())
  }
}

describe "funcionamiento de los PowerUps" {
  const acelerador = new ModificadorDeVelocidad(imagen = "placeholders/diana.png", x = 3, y = 3, velocidad = veloz)
  const relentizador = new ModificadorDeVelocidad(imagen = "placeholders/tuca.png", x = 4, y = 4, velocidad = lento)

  test "cuando un powerUp recibe un choque del helado desaparece" {
    game.addVisual(acelerador)
    acelerador.recibirChoqueDe(helado)
    assert.equals(0, game.getObjectsIn(acelerador.position()).size())
  }

  test "cuando un helado agarra un acelerador se mueve más rápido que antes de agarrarlo" {
    const velInicial = helado.velocidad()
    const intInicial = velInicial.intervalo()
    acelerador.recibirChoqueDe(helado)
    const velFinal = helado.velocidad()
    const intFinal = velFinal.intervalo()
    assert.that(intFinal<intInicial)
  }
  test "cuando un helado agarra un relentizador se mueve más lento que antes de agarrarlo" {
    const velInicial = helado.velocidad()
    const intInicial = velInicial.intervalo()
    relentizador.recibirChoqueDe(helado)
    const velFinal = helado.velocidad()
    const intFinal = velFinal.intervalo()
    assert.that(intFinal>intInicial)
  }
}
describe "hielo"{

  method initialize() {
    game.clear()
    game.width(15)     
    game.height(15)
    helado.reiniciar()
  }
  test "no se pueden crear dos hielos en la misma celda" {
    helado.crearHielo()
    helado.crearHielo()
    assert.equals(1, game.getObjectsIn(game.at(1, 0)).size())
  }

  test "el hielo se crea en la dirección en la que mira el helado" {
    helado.position(game.at(5, 5))
    helado.moverHacia(arriba)               // pasa a (5,6) mirando hacia arriba
    helado.crearHielo()
    assert.that(manejadorDeHielo.hayHieloEn(game.at(5, 7)))
  }

  test "romper hielo elimina el hielo de adelante" {
    helado.crearHielo()
    helado.romperHielo()
    assert.notThat(manejadorDeHielo.hayHieloEn(game.at(1, 0)))
    assert.equals(0, game.getObjectsIn(game.at(1, 0)).size())
  }
  
  test "el helado no puede atravesar un hielo" {
    manejadorDeHielo.crearHieloEn(game.at(1, 0))
    helado.moverHacia(derecha)
    assert.equals(game.at(0, 0), helado.position())
  }

    test "el hielo resistente NO se rompe a la primera, más SI a la segunda" {
    manejadorDeHielo.crearHieloResistenteEn(game.at(1, 0))
    helado.romperHielo()
    assert.that(manejadorDeHielo.hayHieloEn(game.at(1, 0)))
    helado.romperHielo()
    assert.notThat(manejadorDeHielo.hayHieloEn(game.at(1, 0)))
  }

  test "cuando un hielo pasa por encima de una fruta esta se sigue viendo a través de él" {
    const fruta = new Frambuesa (position = game.at(1,1))
    manejadorDeHielo.crearHieloEn(game.at(1, 1))
    fruta.actualizarCongelamiento()
    assert.equals("placeholders/frambuesaCongelada.png", fruta.image())
  }
}

 describe "enemigos" {

  method initialize() {
    game.clear()
    game.width(15)
    game.height(15)
    helado.reiniciar()
    manejadorDeEnemigos.cargarEnemigos([])
  }

  test "un enemigo rectangular mata al helado al chocar con él" {
    const enemigo = new EnemigoRectangular(x=1, lix=0, lsx=14, y=1, liy=0, lsy=14)
    enemigo.recibirChoqueDe(helado)
    assert.notThat(helado.estaVivo())
  }

  test "un enemigo rectangular se da vuelta al chocar con un hielo" {
    const enemigo = new EnemigoRectangular(x=5, lix=0, lsx=14, y=5, liy=0, lsy=14)
    manejadorDeHielo.crearHieloEn(game.at(6, 5))
    enemigo.movete()                              // choca con el hielo y cambia de sentido
    assert.equals(game.at(5, 5), enemigo.position())
    enemigo.movete()                              // ahora va hacia el otro lado
    assert.equals(game.at(4, 5), enemigo.position())
  }

  test "el manejador mueve a enemigos de distinto tipo (polimorfismo)" {
    helado.position(game.at(0, 0))
    const rectangular = new EnemigoRectangular(x=5, lix=0, lsx=14, y=5, liy=0, lsy=14)
    const perseguidor = new EnemigoPerseguidor(position = game.at(10, 5))
    manejadorDeEnemigos.cargarEnemigos([rectangular, perseguidor])
    manejadorDeEnemigos.moverEnemigos()
    assert.equals(game.at(6, 5), rectangular.position())
    assert.equals(game.at(9, 5), perseguidor.position())
  }
}


describe "fases de frutas" {

  method initialize() {
    game.clear()
    game.width(15)
    game.height(15)
    helado.reiniciar()
    puntaje.reiniciar()
  }

  test "al comer todas las frambuesas aparecen las uvas" {
    nivel1.agregarFrambuesa(3, 3)
    nivel1.agregarUva(5, 5)
    assert.notThat(nivel1.hayFrutaEn(game.at(5, 5)))   // todavía en espera
    nivel1.frutaEn(game.at(3, 3)).recibirChoqueDe(helado)
    assert.that(nivel1.hayFrutaEn(game.at(5, 5)))      // ahora activa
    assert.equals(1, game.getObjectsIn(game.at(5, 5)).size())
  }
}

describe "cartel de game over" {

  method initialize() {
    game.clear()
    game.width(15)
    game.height(15)
    helado.reiniciar()
  }

  test "mientras el helado está vivo no hay cartel" {
    assert.equals(0, game.getObjectsIn(textoGameOver.position()).size())
    assert.equals(0, game.getObjectsIn(textoReintentar.position()).size())
  }

  test "cuando el helado muere se muestra el texto de game over" {
    helado.morir()
    assert.that(game.getObjectsIn(textoGameOver.position()).contains(textoGameOver))
  }

  test "cuando el helado muere se muestra el texto de reintentar" {
    helado.morir()
    assert.that(game.getObjectsIn(textoReintentar.position()).contains(textoReintentar))
  }

  //si una vez muerto le pasa otro enemigo por arriba
  test "si el helado muere dos veces los textos se muestras una sola vez" {
    helado.morir()
    helado.morir()
    assert.equals(1, game.getObjectsIn(textoGameOver.position()).size())
    assert.equals(1, game.getObjectsIn(textoReintentar.position()).size())
  }
}

describe "fin del juego" {

  method initialize() {
    game.clear()
    game.width(15)
    game.height(15)
    helado.reiniciar()
  }

  test "el fin del juego entiende los mensajes que el resto del juego le manda a un nivel" {
    finDelJuego.refrescarCongelamientoEn(game.at(1, 1))
    assert.notThat(finDelJuego.hayParedEn(game.at(1, 1)))
  }

  test "al llegar al fin del juego el helado queda quieto" {
    finDelJuego.iniciar()
    helado.moverHacia(derecha)
    assert.equals(game.at(0, 0), helado.position())
  }
}