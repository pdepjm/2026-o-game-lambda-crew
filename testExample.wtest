import manejadores.*
import helado.*
import direcciones.*
import frutas.*
import powerUps.*
import wollok.game.*
import extras.*

describe "consumisición de frutas" {

  const frut = new Fruta(x = 3, y = 3, imagen = "placeholders/frambuesa.jpg", puntos = 100)
  test "cuando la fruta recibe un choque del helado aumenta en 1 el contador de frutas comidas" {
    frut.recibirChoqueDe(helado)
    assert.equals(1,cantFrut.frutas())
  }
  test "cuando la fruta recibe un choque del helado desaparece" {
    frut.recibirChoqueDe(helado)
    assert.equals(0, game.getObjectsIn(frut.position()).size())
  }

  test "cuando la fruta recibe un choque del helado suma la cantidad de puntos correspondiente a la fruta" {
    frut.recibirChoqueDe(helado)
    assert.equals(frut.puntosOtorgados(), puntaje.puntos())
  }

  test "cuando se agarran todas las frambuesas aparecen uvas" {
    manejadorDeFrutas.crearFrambuesas()
    manejadorDeFrutas.frambuesasCreadas().forEach{frambuesa => frambuesa.recibirChoqueDe(helado)}
    assert.equals("uva",manejadorDeFrutas.frutaActual())
  }

}
describe "movimiento del helado" {
  test "al ir a la derecha avanza una casilla" {
    helado.moverHacia(derecha)
    assert.equals(game.at(1, 0), helado.position())
  }
}

describe "funcionamiento de los PowerUps" {
  test "cuando un powerUp recibe un choque del helado desaparece" {
    acelerador.recibirChoqueDe(helado)
    assert.equals(0, game.getObjectsIn(acelerador.position()).size())
  }
  test "cuando un helado agarra un acelerador se mueve más rápido que antes de agarrarlo" {
    const velInicial = helado.velocidad()
    const intInicial = velInicial.intervalo()
    acelerador.recibirChoqueDe(helado)
    const velFinal = helado.velocidad()
    const intFinal = velFinal.intervalo()
    assert.that(intFinal<intInicial)
  }
  test "cuando un helado agarra un relentizador se mueve más lento que antes de agarrarlo" {
    const velInicial = helado.velocidad()
    const intInicial = velInicial.intervalo()
    relentizador.recibirChoqueDe(helado)
    const velFinal = helado.velocidad()
    const intFinal = velFinal.intervalo()
    assert.that(intFinal>intInicial)
  }
}
describe "hielo"{

  method initialize() {
    game.clear()
    game.width(15)     
    game.height(15)
    helado.reiniciar()
  }
  test "no se pueden crear dos hielos en la misma celda" {
    helado.crearHielo()
    helado.crearHielo()
    assert.equals(1, game.getObjectsIn(game.at(1, 0)).size())
  }

  test "el hielo se crea en la dirección en la que mira el helado" {
    helado.position(game.at(5, 5))
    helado.moverHacia(arriba)               // pasa a (5,6) mirando hacia arriba
    helado.crearHielo()
    assert.that(helado.hayHieloEn(game.at(5, 7)))
  }

  test "romper hielo elimina el hielo de adelante" {
    helado.crearHielo()
    helado.iniciarRompidaDeHielo()
    helado.continuarRompidaDeHielo()
    assert.notThat(helado.hayHieloEn(game.at(1, 0)))
    assert.equals(0, game.getObjectsIn(game.at(1, 0)).size())
  }
}