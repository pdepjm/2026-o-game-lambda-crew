import wollok.game.*

import objetos.*

program juego {
	
	const tick = game.tick(666, { manejadorDeEnemigos.moverEnemigos() }, false)

	game.cellSize(100)
	game.title("Pepita")
	game.height(15)
	game.width(15)
	game.ground("placeholders/suelo.jpg")
	game.addVisual(helado)
	game.addVisual(pared)
	game.addVisual(puntaje)
	
	tick.start()

	keyboard.left().onPressDo{helado.izquierda()}
	keyboard.right().onPressDo{helado.derecha()}
	keyboard.up().onPressDo{helado.subir()}
	keyboard.down().onPressDo{helado.bajar()}

	game.onCollideDo(helado, {elemento => helado.comer(elemento)})

	creadorDeFrutas.crearFrambuesas()
	manejadorDeEnemigos.crearEnemigosMovRect()
	
	game.start()
}
