import wollok.game.*

import objetos.*

program juego {
	
	const tick = game.tick(666, { manejadorDeEnemigos.moverEnemigos() }, false)

	game.cellSize(100)
	game.title("Pepita")
	game.height(15)
	game.width(15)
	game.ground("placeholders/suelo.jpg")
	game.addVisual(helado)
	game.addVisual(pared)
	game.addVisual(puntaje)
	game.addVisual(cantFrut)
	game.addVisual(acelerador)
	game.addVisual(relentizador)
	
	tick.start()

	keyboard.left().whilePressedDo({helado.izquierda()}, helado.velocidad())
	keyboard.right().whilePressedDo({helado.derecha()}, helado.velocidad())
	keyboard.up().whilePressedDo({helado.subir()}, helado.velocidad())
	keyboard.down().whilePressedDo({helado.bajar()}, helado.velocidad())

	game.onCollideDo(helado, {elemento => helado.consumir(elemento)})

	creadorDeFrutas.crearFrambuesas()
	manejadorDeEnemigos.crearEnemigosMovRect()
	
	game.start()
}
