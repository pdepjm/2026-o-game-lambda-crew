import wollok.game.*

import enemigos.*
import manejadores.*
import frutas_y_powerups.*
import extras.*
import helado.*
import direcciones.*
import velocidades.*
import hielos.*

program juego {
	
	const tick = game.tick(666, { manejadorDeEnemigos.moverEnemigos() }, false)

	game.cellSize(100)
	game.title("Pepita")
	game.height(15)
	game.width(15)
	game.ground("placeholders/suelo.jpg")
	
	configuracion.iniciar()
	
	game.start()
}
